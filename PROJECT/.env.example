# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/event-ticketing

# Required for local email/password sessions. Use a unique random value and never commit it.
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEMO_PASSWORD=choose-a-local-demo-password

# Existing authentication configuration
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
PORT=3000
